// Schedule Event
register_activation_hook(__FILE__, 'dtp_schedule_event');
function dtp_schedule_event() {
    if (!wp_next_scheduled('dtp_fetch_tweets_event')) {
        wp_schedule_event(time(), 'every_five_minutes', 'dtp_fetch_tweets_event');
    }
}

// Unschedule Event
register_deactivation_hook(__FILE__, 'dtp_unschedule_event');
function dtp_unschedule_event() {
    $timestamp = wp_next_scheduled('dtp_fetch_tweets_event');
    if ($timestamp) {
        wp_unschedule_event($timestamp, 'dtp_fetch_tweets_event');
    }
}

// Fetch Tweets
function dtp_fetch_tweets($keywords) {
    $options = get_option('dtp_settings');
    $bearer_token = sanitize_text_field($options['dtp_twitter_bearer_token']);
    
    // Get the timestamp from the last fetch
    $last_fetch_time = get_option('dtp_last_fetch_time', 0);
    $current_time = time();
    
    // Calculate the time 6 hours ago
    $six_hours_ago = $current_time - (6 * 60 * 60);
    
    // Update the last fetch time if it's older than 6 hours
    if ($last_fetch_time < $six_hours_ago) {
        $url = "https://api.twitter.com/2/tweets/search/recent?query=" . urlencode($keywords) . "&start_time=" . gmdate('Y-m-d\TH:i:s\Z', $six_hours_ago);
        
        $response = wp_remote_get($url, array(
            'headers' => array(
                'Authorization' => 'Bearer ' . $bearer_token,
            ),
        ));

        // Check for errors in the response
        if (is_wp_error($response)) {
            error_log('Twitter API Error: ' . $response->get_error_message());
            return [];
        }

        // Decode the response
        $data = json_decode(wp_remote_retrieve_body($response), true);
        
        // Log the entire response for debugging
        error_log('Twitter API Response: ' . print_r($data, true)); // Use print_r to log arrays

        // Check if we received a 401 Unauthorized error
        if (isset($data['status']) && $data['status'] === 401) {
            error_log('Unauthorized access: ' . print_r($data, true));
            return [];
        }

        // Check if there are tweets in the response
        if (isset($data['data']) && is_array($data['data'])) {
            // Log fetched tweets for debugging
            error_log('Fetched Tweets: ' . print_r($data['data'], true));
            // Update the last fetch time to now
            update_option('dtp_last_fetch_time', $current_time);
            return $data['data'];
        } else {
            error_log('No tweets found or API response error: ' . print_r($data, true));
            return [];
        }
    } else {
        error_log('No new tweets found since the last fetch.');
        return [];
    }
}

// Generate Posts
function dtp_generate_posts($tweets) {
    $options = get_option('dtp_settings');
    $post_status = sanitize_text_field($options['dtp_post_status']);
    $custom_prompt = sanitize_textarea_field($options['dtp_custom_prompt']);

    foreach ($tweets as $tweet) {
        $content = str_replace('{tweet}', sanitize_text_field($tweet['text']), $custom_prompt);
        
        // Log content for debugging
        error_log('Generating content from tweet: ' . $content); // Ensure this is a string

        $new_post = array(
            'post_title'   => wp_trim_words($tweet['text'], 10),
            'post_content' => $content,
            'post_status'  => $post_status,
            'post_author'  => get_current_user_id(),
        );

        $post_id = wp_insert_post($new_post);
        
        // Log post creation result
        if (is_wp_error($post_id)) {
            error_log('Post Creation Error: ' . $post_id->get_error_message());
        } else {
            error_log('Post created with ID: ' . $post_id);
        }
    }
}

// Fetch Tweets and Generate Posts
add_action('dtp_fetch_tweets_event', 'dtp_execute');
function dtp_execute() {
    $options = get_option('dtp_settings');
    $keywords = sanitize_text_field($options['dtp_search_keywords']);
    
    // Log the keywords being searched
    error_log('Searching for tweets with keywords: ' . $keywords);
    
    $tweets = dtp_fetch_tweets($keywords);

    if (!empty($tweets)) {
        dtp_generate_posts($tweets);
    } else {
        error_log('No tweets found to generate posts.');
    }
}
